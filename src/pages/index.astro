---
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
---


<!DOCTYPE html>
<html
>
  <Header title="Ikhwan Salihin" />
  <body>
    <div class="content">
      <Sidebar selectedItem="home" />
      <nav class="main">
        <div class="container">
          <main class="fold-content-container">
            <div class="fold-content">
              <h1>Hi, I'm Ikhwan.<br />I build things for the web.</h1>
              <p class="lead">
                Experienced backend developer and a little bit of frontend, devops. A proactive team member dedicated to continuous learning, problem-solving, and aiding teammates in achieving quicker outcomes.
              </p>
            </div>
            <a href="mailto:ikhwansalihin97@gmail.com" class="button w-button">Contact</a>
          </main>
          <div class="projects-section">
            <!-- Software Development -->
            <a href="/software-development" class="projects-container">
              <div class="single-projects-category">
                <div class="projects-category-image-container">
                  <img src="./assets/browser.svg" loading="lazy" alt="" class="projects-category-image" />
                </div>
              </div>
              <div class="single-projects-content">
                <h4>Software Development</h4>
                <div class="tech-tools-container">
                  <div class="mini-label-white gray-color">Technologies &amp; tools</div>
                  <div class="chips-container chips-container-small-width">
                    <div class="single-chip small-chip">Laravel</div>
                    <div class="single-chip small-chip">Codeigniter</div>
                    <div class="single-chip small-chip">React</div>
                    <div class="single-chip small-chip">TypeScript</div>
                    <div class="single-chip small-chip">Inertia.js</div>
                    <div class="single-chip small-chip">Astro</div>
                    <div class="single-chip small-chip">Node.js</div>
                    <div class="single-chip small-chip">PHP</div>
                    <div class="single-chip small-chip">MariaDB</div>
                    <div class="single-chip small-chip">SQLite</div>
                    <div class="single-chip small-chip">Tailwind CSS</div>
                    <div class="single-chip small-chip">Vite</div>
                    <div class="single-chip small-chip">Git</div>
                    <div class="single-chip small-chip">REST APIs</div>
                    <div class="single-chip small-chip">shadcn/ui</div>
                  </div>
                </div>
              </div>
            </a>
            <!-- DevOps & Cloud -->
            <a href="/devops" class="projects-container">
              <div class="single-projects-category">
                <div class="projects-category-image-container devops-img">
                  <img src="./assets/database.svg" loading="lazy" alt="" class="projects-category-image" />
                </div>
              </div>
              <div class="single-projects-content">
                <h4>DevOps &amp;&nbsp;Cloud</h4>
                <div class="tech-tools-container">
                  <div class="mini-label-white gray-color">Technologies &amp; tools</div>
                  <div class="chips-container chips-container-small-width">
                    <div class="single-chip small-chip">AWS</div>
                    <div class="single-chip small-chip">Alibaba Cloud</div>
                    <div class="single-chip small-chip">Cloudflare</div>
                    <div class="single-chip small-chip">Nginx</div>
                    <div class="single-chip small-chip">PM2</div>
                    <div class="single-chip small-chip">Linux</div>
                    <div class="single-chip small-chip">Bash</div>
                    <div class="single-chip small-chip">Raspberry Pi</div>
                    <div class="single-chip small-chip">Cloudflare Tunnel</div>
                    <div class="single-chip small-chip">PHP-FPM</div>
                    <div class="single-chip small-chip">SSL/TLS</div>
                    <div class="single-chip small-chip">Git</div>
                    <div class="single-chip small-chip">Systemd</div>
                    <div class="single-chip small-chip">Server Management</div>
                  </div>
                </div>
              </div>
            </a>
          </div>
        </div>
      </nav>
    </div>

    <!--[if lte IE 9]><script src="//cdnjs.cloudflare.com/ajax/libs/placeholders/3.0.2/placeholders.min.js"></script><![endif]-->
  </body>
</html>